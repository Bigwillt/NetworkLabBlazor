@page "/networklab"
@using NetworkLabBlazor.Services
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav

<button class="copy-btn" onclick="window.print()">Download as PDF</button>

<h1>Network Lab</h1>

<div class="container">
    <img src="images/Network Diagram.png" alt="Network Diagram made with SketchWow. It shows two LANs (PC, switch, router) connected by a WAN.">

@if (Addressing == null || Addressing.Count == 0)
{
    <div class="alert alert-info">
        No lab generated yet. Click <strong>Generate New Lab</strong> to begin.
    </div>
}
else
{
    <h3>Addressing Table</h3>
    <AddressTable Items="Addressing" />
}

    <button class="btn btn-primary mb-3" @onclick="GenerateLab">
    Generate New Lab
    </button>

    <div class="mt-2 mb-3">
        <label>Seed (optional):</label>
        <input @bind="Seed" class="form-control w-auto d-inline-block" />
    </div>


<!-- R1 -->
<div class="mb-3">
    <button class="btn btn-outline-primary d-flex align-items-center"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#r1Section"
            aria-expanded="false"
            aria-controls="r1Section">
        <i class="bi bi-chevron-down me-2"></i>
        R1 Configuration
    </button>

    <div class="collapse show mt-2" id="r1Section">
        <SpecTable Items="R1Specs" />
    </div>
</div>

<!-- R2 -->
<div class="mb-3">
    <button class="btn btn-outline-primary d-flex align-items-center"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#r2Section"
            aria-expanded="false"
            aria-controls="r2Section">
        <i class="bi bi-chevron-down me-2"></i>
        R2 Configuration
    </button>

    <div class="collapse show mt-2" id="r2Section">
        <SpecTable Items="R2Specs" />
    </div>
</div>

<!-- SW1 -->
<div class="mb-3">
    <button class="btn btn-outline-primary d-flex align-items-center"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#sw1Section"
            aria-expanded="false"
            aria-controls="sw1Section">
        <i class="bi bi-chevron-down me-2"></i>
        SW1 Configuration
    </button>

    <div class="collapse show mt-2" id="sw1Section">
        <SpecTable Items="SW1Specs" />
    </div>
</div>

<!-- SW2 -->
<div class="mb-3">
    <button class="btn btn-outline-primary d-flex align-items-center"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#sw2Section"
            aria-expanded="false"
            aria-controls="sw2Section">
        <i class="bi bi-chevron-down me-2"></i>
        SW2 Configuration
    </button>

    <div class="collapse show mt-2" id="sw2Section">
        <SpecTable Items="SW2Specs" />
    </div>
</div>

@if (PC1Specs is not null)
{
    <!-- PC1 -->
    <div class="mb-3">
        <button class="btn btn-outline-primary d-flex align-items-center"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#pc1Section"
                aria-expanded="false"
                aria-controls="pc1Section">
            <i class="bi bi-chevron-down me-2"></i>
            PC1 Network Configuration
        </button>

        <div class="collapse show mt-2" id="pc1Section">
            <SpecTable Items="PC1Specs" />
        </div>
    </div>
}

@if (PC2Specs is not null)
{
    <!-- PC2 -->
    <div class="mb-3">
        <button class="btn btn-outline-primary d-flex align-items-center"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#pc2Section"
                aria-expanded="false"
                aria-controls="pc2Section">
            <i class="bi bi-chevron-down me-2"></i>
            PC2 Network Configuration
        </button>

        <div class="collapse show mt-2" id="pc2Section">
            <SpecTable Items="PC2Specs" />
        </div>
    </div>
}

<p>Upon completing your local network, attempt to connect to a neighboring network. Use routing for a Gateway of Last Resort for simplified setup in this lab.</p>
<p style="font-family:'Courier New', monospace;">  <b>ip route 0.0.0.0 0.0.0.0</b> <i>{ip-address | exit-int}</i>  </p> 

<footer class="site-footer">
    © @DateTime.Now.Year Tim Williamson. All rights reserved.
</footer>

</div>

@code {
    private List<AddressGroup> Addressing = new();
    private bool ShowToast = false;
    private int? Seed { get; set; }

    List<SpecRow> R1Specs = new()
    {
        new() { Task = "Router name", Specification = "R1" },
        new() { Task = "Domain name", Specification = "r1.labnet.local" },
        new() { Task = "Encrypted privileged exec password", Specification = "R1secure!" },
        new() { Task = "Console access password", Specification = "R1console" },
        new() { Task = "Encrypt the clear text passwords", Specification = "Yes" },
        new() { Task = "MOTD Banner", Specification = "R1 Authorized Access Only" },
        new() { Task = "Interface G0/0", Specification = "Set Description" },
        new() { Task = "Interface G0/0", Specification = "Set IP Address" },
        new() { Task = "Interface G0/0", Specification = "Activate Interface" },
        new() { Task = "Interface G0/1", Specification = "Set Description" },
        new() { Task = "Interface G0/1", Specification = "Set IP Address" },
        new() { Task = "Interface G0/1", Specification = "Activate Interface" }
    };

    List<SpecRow> R2Specs = new()
    {
        new() { Task = "Router name", Specification = "R2" },
        new() { Task = "Domain name", Specification = "r2.labnet.local" },
        new() { Task = "Encrypted privileged exec password", Specification = "R2secure!" },
        new() { Task = "Console access password", Specification = "R2console" },
        new() { Task = "Encrypt the clear text passwords", Specification = "Yes" },
        new() { Task = "MOTD Banner", Specification = "R2 Authorized Access Only" },
        new() { Task = "Interface G0/0", Specification = "Set Description" },
        new() { Task = "Interface G0/0", Specification = "Set IP Address" },
        new() { Task = "Interface G0/0", Specification = "Activate Interface" },
        new() { Task = "Interface G0/1", Specification = "Set Description" },
        new() { Task = "Interface G0/1", Specification = "Set IP Address" },
        new() { Task = "Interface G0/1", Specification = "Activate Interface" }
    };

    List<SpecRow> SW1Specs = new()
    {
        new() { Task = "Switch name", Specification = "SW1" },
        new() { Task = "Configure Management Interface (SVI)", Specification = "Set the Layer 3 IPv4 Address" },
        new() { Task = "Encrypted privileged exec password", Specification = "B0nza!" },
        new() { Task = "Set console access password", Specification = "Con@cc1" },
        new() { Task = "Set the SSH password", Specification = "TelNetSux" },
        new() { Task = "Set the Default Gateway Address", Specification = "" }
    };

    List<SpecRow> SW2Specs = new()
    {
        new() { Task = "Switch name", Specification = "SW2" },
        new() { Task = "Configure Management Interface (SVI)", Specification = "Set the Layer 3 IPv4 Address" },
        new() { Task = "Encrypted privileged exec password", Specification = "B0nza!" },
        new() { Task = "Set console access password", Specification = "Con@cc1" },
        new() { Task = "Set the SSH password", Specification = "TelNetSux" },
        new() { Task = "Set the Default Gateway Address", Specification = "" }
    };

    private List<SpecRow>? PC1Specs
    {
        get
        {
            var pc = Addressing.FirstOrDefault(g => g.Device == "PC1");
            var row = pc?.Rows.FirstOrDefault();

            if (row is null)
                return null;

            return new()
            {
                new() { Task = "IP Address", Specification = row.IP },
                new() { Task = "Subnet Mask", Specification = row.Subnet },
            };
        }
    }

    private List<SpecRow>? PC2Specs
    {
        get
        {
            var pc = Addressing.FirstOrDefault(g => g.Device == "PC2");
            var row = pc?.Rows.FirstOrDefault();

            if (row is null)
                return null;

            return new()
            {
                new() { Task = "IP Address", Specification = row.IP },
                new() { Task = "Subnet Mask", Specification = row.Subnet },
            };
        }
    }

    private async void GenerateLab()
    {
        Addressing = LabAddressingGenerator.Generate(Seed);

        ShowToast = true;
        StateHasChanged();

        await Task.Delay(3000);
        ShowToast = false;
        StateHasChanged();
    }
}

