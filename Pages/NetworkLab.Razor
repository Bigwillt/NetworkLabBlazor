private List<SpecRow> PC1Specs
{
    get
    {
        var pc = Addressing.First(g => g.Device == "PC1").Rows.First();

        return new()
        {
            new() { Task = "IP Address", Specification = pc.IP },
            new() { Task = "Subnet Mask", Specification = pc.Subnet },
            new() { Task = "Default Gateway", Specification = pc.Gateway }
        };
    }
}

private List<SpecRow> PC2Specs
{
    get
    {
        var pc = Addressing.First(g => g.Device == "PC2").Rows.First();

        return new()
        {
            new() { Task = "IP Address", Specification = pc.IP },
            new() { Task = "Subnet Mask", Specification = pc.Subnet },
            new() { Task = "Default Gateway", Specification = pc.Gateway }
        };
    }
}

<button class="btn btn-primary mb-3" @onclick="GenerateLab">
    Generate New Lab
</button>

@if (Addressing == null || Addressing.Count == 0)
{
    <div class="alert alert-info">
        No lab generated yet. Click <strong>Generate New Lab</strong> to begin.
    </div>
}
else
{
    <AddressTable Groups="Addressing" />
}AddressTable Groups="Addressing" />

<div class="toast-container position-fixed top-0 end-0 p-3">
    @if (ShowToast)
    {
        <div class="toast show align-items-center text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    Lab Generated!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick="() => ShowToast = false"></button>
            </div>
        </div>
    }
</div>


@code {
    private List<AddressGroup> Addressing = new();

    private void GenerateLab()
    {
        Addressing = LabAddressingGenerator.Generate();
    }

    private bool ShowToast = false;

    private async void GenerateLab()
    {
        Addressing = LabAddressingGenerator.Generate();

        ShowToast = true;
        StateHasChanged();

        // Auto-hide after 3 seconds
        await Task.Delay(3000);
        ShowToast = false;
        StateHasChanged();
    }
}

